# Copy to superset/.env and fill in real values. Never commit .env.
# Generate the secret: openssl rand -base64 42

SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=replace-with-openssl-rand-base64-42

POSTGRES_USER=superset
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=superset

SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace-with-a-strong-password
SUPERSET_ADMIN_EMAIL=admin@example.com

# Path inside the superset container. ../data/marts is mounted read-only at /data.
DELIVERY_DUCKDB_URI=duckdb:////data/delivery.duckdb
